<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatusHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/likely_disease"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDisease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confidence_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/description_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblSymptoms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/symptoms_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblCauses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/causes_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCauses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblPrevention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prevention_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvPrevention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblTreatment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/treatment_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvTreatment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/lblTopPredictions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/top_predictions_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvTopPredictions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_disclaimer"
            android:textColor="#D32F2F"
            android:textStyle="italic"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAnalyzeAnother"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/analyze_another" />
    </LinearLayout>
</ScrollView>